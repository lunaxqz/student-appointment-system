PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appointments_db
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password
# OPTIONAL for demos and local development: without it the server makes a temporary secret on every start.
# REQUIRED in production (NODE_ENV=production). Use a long random string (32+ characters) and never commit it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=replace_with_a_long_random_string

# Campus time zone used to turn "Monday 09:00" into exact appointment times (IANA name). Default: Asia/Manila.
# APP_TIMEZONE=Asia/Manila
